# Copy to .env (gitignored) and adjust. Read by docker compose and MADSci settings.

# Database credentials for the manager stack
POSTGRES_USER=madsci
POSTGRES_PASSWORD=madsci
POSTGRES_DB=postgres
RESOURCE_DB_URL=postgresql://madsci:madsci@localhost:5434/resources
DOCUMENT_DB_URL=mongodb://madsci:madsci@localhost:27017/

# SSH login to the Pen-side Raspberry Pi 5 (used by formulator_pen_weighing_node).
# Enter the IP address or hostname of the Pen-side Raspberry Pi 5:
PEN_RPI_HOST=<pen-rpi-host>
# Enter the login user on the Pen-side Raspberry Pi 5:
PEN_RPI_USER=<pen-rpi-user>
# Enter that user's password:
PEN_RPI_PASSWORD=<pen-rpi-password>

# Location Manager seed, read when its database is empty. The example geometry
# runs without hardware; for the real station use ./locations.yaml with the
# values taught on it.
LOCATIONS_FILE=./locations.example.yaml
